# ── Backend ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/rootpass?retryWrites=true&w=majority

# Solana
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=<YOUR_DEPLOYED_ANCHOR_PROGRAM_ID>

# Issuer wallet (base58 private key — NEVER commit real keys)
ISSUER_PRIVATE_KEY=<BASE58_PRIVATE_KEY>

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_PROGRAM_ID=<YOUR_DEPLOYED_ANCHOR_PROGRAM_ID>
